# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_SERVICE_ACCOUNT_EMAIL: The Google Cloud service account email (with Google Sheets API enabled)
GOOGLE_SERVICE_ACCOUNT_EMAIL="realdeals-erp@my-gcp-project.iam.gserviceaccount.com"

# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY: The PEM private key from the downloaded service account JSON file
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# GOOGLE_SPREADSHEET_ID: Target Google Sheet ID shared with the service account as Editor
GOOGLE_SPREADSHEET_ID="1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms"
